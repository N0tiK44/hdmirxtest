#!/sbin/openrc-run

description="Load the audited hdmirxtest HDMI-RX bridge EDID"

VIDEO=${VIDEO:-/dev/video0}
EDID=${EDID:-/var/lib/hdmirxtest/bridge-edid.bin}
READBACK=/run/hdmirxtest-edid-readback.bin

depend() {
    need localmount
    after modules
    before networking
}

start() {
    ebegin "Loading safe HDMI-RX bridge EDID"

    attempts=0
    while [ ! -e "$VIDEO" ] && [ "$attempts" -lt 50 ]; do
        sleep 0.1
        attempts=$((attempts + 1))
    done

    if [ ! -e "$VIDEO" ] || [ ! -s "$EDID" ]; then
        eend 1 "HDMI-RX device or bridge EDID is unavailable"
        return 1
    fi

    if ! v4l2-ctl -d "$VIDEO" --set-edid=pad=0,file="$EDID",format=raw >/dev/null 2>&1 ||
       ! v4l2-ctl -d "$VIDEO" --get-edid=pad=0,format=raw,file="$READBACK" >/dev/null 2>&1 ||
       ! cmp -s "$EDID" "$READBACK"; then
        eend 1 "HDMI-RX EDID write/read-back verification failed"
        return 1
    fi

    eend 0
}
