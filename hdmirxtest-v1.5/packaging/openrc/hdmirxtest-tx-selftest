#!/sbin/openrc-run

description="HDMIRXTEST HDMI-TX-only offline display probe"
command=/usr/local/libexec/hdmirxtest-tx-selftest-service
pidfile=/run/hdmirxtest-tx-selftest.pid
command_background=true
output_log=/var/log/hdmirxtest-tx-selftest.log
error_log=/var/log/hdmirxtest-tx-selftest.log

depend() {
    need localmount
    after modules
    before networking
}

start_pre() {
    checkpath -d -m 0755 /run/hdmirxtest /var/lib/hdmirxtest/tx-history
    export CARD CONNECTOR_NAME SECONDS_TO_RUN WAIT_SECONDS
}
