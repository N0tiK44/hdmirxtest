[Unit]
Description=Load and verify hdmirxtest HDMI-RX bridge EDID
After=local-fs.target systemd-udev-settle.service
ConditionPathExists=/var/lib/hdmirxtest/bridge-edid.bin

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/hdmirxtest
ExecStart=/usr/local/libexec/hdmirxtest-load-edid
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
