[Unit]
Description=HDMIRXTEST HDMI-TX-only offline display test
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Conflicts=hdmirxtest-passthrough.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/hdmirxtest-tx-selftest
ExecStart=/usr/local/libexec/hdmirxtest-tx-selftest-service
TimeoutStartSec=180
StandardInput=null

[Install]
WantedBy=multi-user.target
